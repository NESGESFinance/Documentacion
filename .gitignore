!*.sample
!*.template

# ------------------------------------------------------------
# Excepciones documentales explícitas
#
# Estos archivos son controles institucionales y deben permanecer
# versionados cuando hayan sido aprobados para publicación.
# ------------------------------------------------------------

!README.md
!LICENSE
!.gitignore
!CHANGELOG_DOCUMENTAL.md
!CHECKLIST_PUBLICACION_GITHUB_PAGES.md
!GLOSARIO_NESGESFinance.md
!MATRIZ_TRAZABILIDAD_CLAIMS.csv
!Politica_Control_Documental.md

